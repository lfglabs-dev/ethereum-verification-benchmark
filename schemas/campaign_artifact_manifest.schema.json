{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign_artifact_manifest.schema.json",
  "title": "Campaign artifact manifest",
  "type": "object",
  "required": [
    "run_id",
    "model_id",
    "commit_sha",
    "lean_version",
    "task_set_id",
    "verity_commit",
    "artifacts"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "lean_version": {"const": "4.31.0"},
    "task_set_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verity_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
