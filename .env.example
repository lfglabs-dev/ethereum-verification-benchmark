# Default Lean-tools harness.
# Any OpenAI-compatible chat-completions provider can be used here.
# Optional profile switch. When set to qwen or glm, provider-specific
# DEFAULT_HARNESS_<PROVIDER>_* values take precedence over the generic values.
# DEFAULT_HARNESS_PROVIDER=qwen
DEFAULT_HARNESS_BASE_URL=https://spark-de79.gazella-vector.ts.net/v1
DEFAULT_HARNESS_MODEL=qwen3.5-397b
DEFAULT_HARNESS_API_KEY=
# Optional hybrid mode. By default the driver model is DEFAULT_HARNESS_MODEL and
# no prover tool is exposed. Set all three values below to let the driver call a
# separate prover for unchecked Lean proof-body drafts.
# DEFAULT_HARNESS_DRIVER_MODEL=minimax/minimax-m3
# DEFAULT_HARNESS_PROVER_MODEL=mistralai/Leanstral-2603
# DEFAULT_HARNESS_PROVER_MODE=draft_proof
#
# Optional cross-provider hybrid: route the prover to a SEPARATE
# OpenAI-compatible endpoint while the driver/tool loop keeps using
# DEFAULT_HARNESS_BASE_URL / DEFAULT_HARNESS_API_KEY. Leave both unset to reuse
# the driver endpoint (single-endpoint hybrid; behavior unchanged). Example: a
# MiniMax driver controlling tools with a Leanstral prover on its own endpoint.
# DEFAULT_HARNESS_PROVER_BASE_URL=https://leanstral-provider.example/v1
# DEFAULT_HARNESS_PROVER_API_KEY=
#
# Optional STRICT role separation for hybrid draft_proof runs. When enabled (and
# draft_proof is active), the driver model is a pure orchestrator and NEVER writes
# or edits proof bodies: the prover writes the first draft (prover_writer stage)
# and repairs failures (proof_repairer stage) via draft_proof mode=repair. The
# driver-side diagnostic-repair loop is disabled so the driver's own Lean ability
# never enters the recorded result. Defaults off (unchanged behavior).
# DEFAULT_HARNESS_STRICT_ROLE_SEPARATION=0
# Max prover repair (mode=repair) calls per task when strict separation is on.
# DEFAULT_HARNESS_PROVER_REPAIR_ATTEMPTS=2
# Size cap of the content-free public declaration index injected into prover
# prompts (public spec/impl/editable declarations only; never hidden Proofs or
# GeneratedPreview). 0 disables the index.
# DEFAULT_HARNESS_DRAFT_PROOF_DECL_INDEX=40
#
# ENSEMBLE-LABEL NOTE: a hybrid run mixes two models. run.json / harness-response
# record role_config.role_label (e.g. "strict-hybrid: driver=X; writer=Y;
# repairer=Y") plus role_metrics_totals. NEVER report a hybrid score as a
# standalone score for the writer model: "driver=X + writer=Y (strict-hybrid)" is
# a different result than "Y standalone". role_config.ensemble=true marks these.

# Provider profiles for quick local switching.
DEFAULT_HARNESS_QWEN_BASE_URL=https://spark-de79.gazella-vector.ts.net/v1
DEFAULT_HARNESS_QWEN_MODEL=qwen3.5-397b
DEFAULT_HARNESS_QWEN_API_KEY=
DEFAULT_HARNESS_GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
DEFAULT_HARNESS_GLM_MODEL=glm-5.1
DEFAULT_HARNESS_GLM_API_KEY=

# Optional tuning for the default harness.
# DEFAULT_HARNESS_MAX_FILE_CHARS=6000
# DEFAULT_HARNESS_PROMPT_CONTEXT_CHARS=8000
# DEFAULT_HARNESS_LEAN_CHECK_TIMEOUT_SECONDS=60
# DEFAULT_HARNESS_REQUEST_TIMEOUT_SECONDS=180
# Advisory cross-process lease serializing memory-heavy Lean verification/build
# steps so multi-provider runs overlap model-API work but do not OOM the host by
# running several ~tens-of-GB `lean` processes at once. At most this many
# verifications run concurrently across all runner processes on the machine.
# Default 1 (safe); set 0 (or negative) to disable leasing entirely. The lease
# is advisory and fail-open: if it cannot be acquired it proceeds anyway.
# DEFAULT_HARNESS_VERIFY_CONCURRENCY=1
# Directory holding the lease slot files (shared by all runner processes on the
# host). Defaults to <tmpdir>/verity-verify-lease.
# DEFAULT_HARNESS_VERIFY_LEASE_DIR=
# Max seconds to wait for a free slot before failing open and proceeding.
# DEFAULT_HARNESS_VERIFY_LEASE_TIMEOUT_SECONDS=1800
# Poll interval (seconds) while waiting for a free slot.
# DEFAULT_HARNESS_VERIFY_LEASE_POLL_SECONDS=0.25
# DEFAULT_HARNESS_STREAMING=1
# DEFAULT_HARNESS_STREAM_IDLE_TIMEOUT_SECONDS=180
# Newline-separated stop strings sent to the provider. Defaults to the ChatML /
# tool-call sentinels (<|im_end|>, <|im_start|>, <|tool_call_begin|>,
# <|tool_call_end|>) so ChatML fine-tunes served via llama.cpp stop at the turn
# boundary instead of degenerating. Set empty to disable.
# DEFAULT_HARNESS_STOP_SEQUENCES=
# DEFAULT_HARNESS_REQUEST_RETRIES=2
# DEFAULT_HARNESS_REQUEST_RETRY_BACKOFF_SECONDS=2
# DEFAULT_HARNESS_MAX_TOOL_CALLS=24
# DEFAULT_HARNESS_MAX_RESPONSE_TOKENS=4096
# Generic OpenAI-compatible request-shape compatibility switch. Some strict
# providers reject any request that carries a token-limit field and answer with
# a generic 400 (observed with Virtuals' openai-gpt-56-sol-pro, which 400s on
# max_tokens / max_completion_tokens / reasoning_effort but returns 201 with
# none of them). Set to 1 to drop every token-limit parameter from the outgoing
# chat-completions request entirely. Provider-neutral (no name special casing);
# leave unset/0 to preserve the default request shape for all other providers.
# DEFAULT_HARNESS_OMIT_MAX_TOKENS=0
# Omit temperature, top_p, and reasoning_effort at the API boundary. This also
# applies to shell harnesses through their metering proxy.
# DEFAULT_HARNESS_OMIT_SAMPLING=0
# DEFAULT_HARNESS_NATIVE_TOOLS=1
# DEFAULT_HARNESS_TOOL_RESULT_CHARS=6000
# DEFAULT_HARNESS_TASK_SUMMARY_CHARS=8000
# DEFAULT_HARNESS_MAX_NON_PROOF_TOOL_CALLS=8
# DEFAULT_HARNESS_ALLOW_GRINDSET_TOOLS=0
# Optional provider-specific context-window hint. Leave unset for strict OpenAI-compatible APIs.
# DEFAULT_HARNESS_CONTEXT_TOKENS=32768
# Sampling. Default temperature 0 (greedy) — top_p=1 is then sent automatically
# so providers that reject greedy-without-top_p (e.g. the Mistral API serving
# Labs Leanstral: HTTP 400 "top_p must be 1 when using greedy sampling") accept
# the request. Raise temperature and/or set a reasoning effort per a vendor's
# recommended regime for their reasoning models.
# DEFAULT_HARNESS_TEMPERATURE=0
# DEFAULT_HARNESS_REASONING_EFFORT=
# Hybrid prover-only sampling override (leaves the driver at the defaults above),
# e.g. Leanstral prover at its vendor regime: temperature 1.0, high effort.
# DEFAULT_HARNESS_PROVER_TEMPERATURE=
# DEFAULT_HARNESS_PROVER_REASONING_EFFORT=
# Public dependency setup is reusable and runs outside provider requests.
# DEFAULT_HARNESS_DEPENDENCY_WARM_TIMEOUT_SECONDS=1800

# Optional initial Grok briefing check timeout.
# VERITY_INITIAL_CHECK_TIMEOUT_SECONDS=180

# Grok Build harness.
# Prefer this in CI or other non-interactive environments.
GROK_CODE_XAI_API_KEY=

# Local-only option: allow the Grok runner to copy ~/.grok/auth.json
# into the temporary run home. Do not use this in CI.
VERITY_ALLOW_HOST_GROK_AUTH=0
